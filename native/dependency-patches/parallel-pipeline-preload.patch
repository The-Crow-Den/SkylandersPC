+void PipelineCache::CreatePendingGraphics(std::vector<PendingGraphics>& pending) {
+    // vkCreate*Pipelines and the layout creations in the constructor are safe on several
+    // threads; the VkPipelineCache is created without EXTERNALLY_SYNCHRONIZED. BB_PRELOAD_THREADS
+    // sets the count (1 keeps the original one-at-a-time preload).
+    unsigned threads = std::clamp(std::thread::hardware_concurrency(), 1u, 16u);
+    if (const char* value = std::getenv("BB_PRELOAD_THREADS"); value && *value) {
+        threads = static_cast<unsigned>(std::clamp(std::atoi(value), 1, 64));
+    }
+    threads = std::min<unsigned>(threads, static_cast<unsigned>(std::max<size_t>(pending.size(), 1)));
+    std::atomic<size_t> next{0};
+    const auto work = [&] {
+        for (size_t i; (i = next.fetch_add(1, std::memory_order_relaxed)) < pending.size();) {
+            auto& entry = pending[i];
+            try {
+                entry.pipeline = std::make_unique<GraphicsPipeline>(
+                    instance, scheduler, desc_heap, profile, entry.key, *pipeline_cache,
+                    entry.infos, entry.runtime_infos, entry.fetch_shader, entry.modules,
+                    entry.sdata, true);
+            } catch (...) {
+                entry.error = std::current_exception();
+            }
+        }
+    };
+    const auto started = std::chrono::steady_clock::now();
+    std::vector<std::thread> workers;
+    for (unsigned i = 1; i < threads; ++i) {
+        workers.emplace_back(work);
+    }
+    work();
+    for (auto& worker : workers) {
+        worker.join();
+    }
+    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+                             std::chrono::steady_clock::now() - started)
+                             .count();
+    std::printf("Pipeline preload: %zu graphics pipelines on %u threads in %lld ms\n",
+                pending.size(), threads, static_cast<long long>(elapsed));
+}
