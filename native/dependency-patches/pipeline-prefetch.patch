+PipelineCompiler& PipelineCache::Compiler() {
+    // Workers (prefetch) and the GPU thread (async passes) share one pool, created once.
+    std::call_once(compiler_once, [this] {
+        const char* env = std::getenv("BB_ASYNC_PIPELINE_THREADS");
+        const u32 threads =
+            std::max(env && *env ? u32(std::strtoul(env, nullptr, 10))
+                                 : std::clamp(std::thread::hardware_concurrency() / 2, 1u, 8u),
+                     1u);
+        compiler = std::make_unique<PipelineCompiler>(threads);
+        std::printf("GPU: background pipeline compiles on %u threads\n", threads);
+    });
+    return *compiler;
+}
+
+void PipelineCache::NoteGraphicsKey(const GraphicsPipelineKey& key) {
+    std::unique_lock lk{prefetch_mutex};
+    known_graphics.insert(key);
+}
+
+std::shared_ptr<PipelineCache::PendingPipeline> PipelineCache::TakePrefetched(
+    const GraphicsPipelineKey& key) {
+    std::unique_lock lk{prefetch_mutex};
+    const auto found = prefetched.find(key);
+    if (found == prefetched.end()) {
+        return nullptr;
+    }
+    auto job = std::move(found->second);
+    prefetched.erase(found);
+    return job;
+}
+
+void PipelineCache::PrefetchGraphicsPipeline(const PipelineSelection& worker_sel) {
+    static const bool enabled = [] {
+        const char* value = std::getenv("BB_PREFETCH_PIPELINES");
+        return !(value && value[0] == '0');
+    }();
+    if (!enabled || !worker_sel.worker) {
+        return;
+    }
+    const auto& key = worker_sel.graphics_key;
+    {
+        std::shared_lock lk{prefetch_mutex};
+        if (known_graphics.contains(key)) {
+            return;
+        }
+    }
+    // The worker's Infos are its own copies; the pipeline takes the canonical ones, as the GPU
+    // thread's selection (and CompileInBackground) does.
+    std::array<const Shader::Info*, MaxShaderStages> infos{};
+    for (u32 stage = 0; stage < MaxShaderStages; ++stage) {
+        if (!worker_sel.infos[stage]) {
+            continue;
+        }
+        for (const auto& [program, copy] : worker_sel.worker->infos) {
+            if (&copy == worker_sel.infos[stage]) {
+                infos[stage] = &program->info;
+                break;
+            }
+        }
+        if (!infos[stage]) {
+            return;
+        }
+    }
+    auto job = std::make_shared<PendingPipeline>();
+    {
+        std::unique_lock lk{prefetch_mutex};
+        if (!known_graphics.insert(key).second) {
+            return;
+        }
+        prefetched.emplace(key, job);
+    }
+    ++g_bb_prefetch_started;
+    Compiler().Submit([this, job, key, infos, runtime_infos = worker_sel.runtime_infos,
+                       fetch = worker_sel.fetch_shader, modules = worker_sel.modules]() mutable {
+        GraphicsPipeline::SerializationSupport sdata{};
+        auto pipeline = std::make_unique<GraphicsPipeline>(
+            instance, scheduler, desc_heap, profile, key, *pipeline_cache, infos, runtime_infos,
+            fetch, modules, sdata, false);
+        std::scoped_lock lk{job->mutex};
+        job->pipeline = std::move(pipeline);
+        job->sdata = std::move(sdata);
+        job->done = true;
+        job->cv.notify_all();
+    });
+}
