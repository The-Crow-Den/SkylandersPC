+ImVec4 PortalColor(const char* element) {
+    const std::string_view e=element?element:"";
+    if(e=="Water")return {0.22f,0.64f,1,1}; if(e=="Life")return {0.4f,0.85f,0.34f,1};
+    if(e=="Fire")return {1,0.4f,0.2f,1}; if(e=="Magic")return {0.75f,0.4f,1,1};
+    if(e=="Earth")return {0.85f,0.62f,0.3f,1}; if(e=="Tech")return {1,0.77f,0.25f,1};
+    if(e=="Undead")return {0.77f,0.78f,0.95f,1}; if(e=="Air")return {0.54f,0.86f,0.95f,1};
+    if(e=="Light")return {1,0.96f,0.7f,1};return {0.76f,0.5f,0.74f,1};
+}
+ImTextureData* PortalAtlas() {
+    static ImTextureData* texture=nullptr;
+    static bool attempted=false;
+    if(attempted)return texture;attempted=true;
+    if(!sky_portal_atlas)return nullptr;
+    FILE* f=std::fopen(sky_portal_atlas(),"rb");if(!f)return nullptr;
+    unsigned size[2]{};
+    if(std::fread(size,sizeof(size),1,f)!=1||size[0]!=1024||size[1]!=768){std::fclose(f);return nullptr;}
+    auto* t=IM_NEW(ImTextureData)();t->Create(ImTextureFormat_RGBA32,1024,768);
+    if(std::fread(t->Pixels,1,t->GetSizeInBytes(),f)!=static_cast<size_t>(t->GetSizeInBytes())){std::fclose(f);IM_DELETE(t);return nullptr;}
+    std::fclose(f);t->UseColors=true;t->UniqueID=10001;
+    // Pinned ImGui rebuilds PlatformIO.Textures each frame. Register ownership
+    // so the Vulkan backend uploads the atlas and retains its descriptor.
+    ImGui::RegisterUserTexture(t);texture=t;return texture;
+}
+bool PortalMatches(const char* name,const char* search) {
+    std::string a=name?name:"",b=search?search:"";
+    std::transform(a.begin(),a.end(),a.begin(),[](unsigned char c){return char(std::tolower(c));});
+    std::transform(b.begin(),b.end(),b.begin(),[](unsigned char c){return char(std::tolower(c));});
+    return a.find(b)!=std::string::npos;
+}
+void PortalCollection(int kind) {
+    static char search[2][96]{};static int element=0;
+    static const char* elements[]{"All elements","Air","Dark","Earth","Fire","Kaos","Life","Light","Magic","Tech","Undead","Water"};
+    ImGui::SetNextItemWidth(-1);ImGui::InputTextWithHint("##search","Search your collection...",search[kind],sizeof(search[kind]));
+    if(kind==1) {ImGui::SetNextItemWidth(-1);ImGui::Combo("##element",&element,elements,12);}
+    else if(ImGui::Button("+ Import Skylander",{-1,32*base_scale})&&sky_portal_action)sky_portal_action(2,0);
+    ImGui::Spacing();
+    auto* atlas=PortalAtlas();
+    ImGui::BeginChild("collection",{0,-66*base_scale});
+    const int count=sky_portal_count(kind);int shown=0;
+    if(ImGui::BeginTable("portrait_grid",3,ImGuiTableFlags_SizingStretchSame)) {
+        for(int i=0;i<count;++i) {
+            const std::string name=sky_portal_name(kind,i);
+            const char* detail=sky_portal_detail(kind,i);
+            if(!PortalMatches(name.c_str(),search[kind])||(kind==1&&element&&std::strcmp(detail,elements[element])))continue;
+            ++shown;ImGui::TableNextColumn();ImGui::PushID(i);
+            const int state=sky_portal_state(kind,i);
+            const auto accent=PortalColor(detail);
+            ImGui::PushStyleColor(ImGuiCol_Button,state&2?ImVec4(0.08f,0.4f,0.4f,1):ImVec4(0.11f,0.16f,0.23f,1));
+            ImGui::PushStyleColor(ImGuiCol_Border,state&2?ImVec4(0.3f,0.95f,0.84f,1):ImVec4(0.2f,0.26f,0.34f,1));
+            ImGui::PushStyleVar(ImGuiStyleVar_FrameBorderSize,state&2?3.0f:1.0f);
+            const float side=std::max(35.0f,ImGui::GetContentRegionAvail().x-6*base_scale);
+            const int cell=sky_portal_portrait(kind,i);bool pressed=false;
+            if(atlas&&cell>=0) {
+                const ImVec2 uv0{float(cell%8)/8.0f,float(cell/8)/6.0f};
+                const ImVec2 uv1{uv0.x+1.0f/8.0f,uv0.y+1.0f/6.0f};
+                pressed=ImGui::ImageButton("##portrait",atlas->GetTexRef(),{side,side},uv0,uv1);
+            } else pressed=ImGui::Button(name.c_str(),{side,side});
+            if(pressed&&sky_portal_action)sky_portal_action(kind,i);
+            if(ImGui::IsItemHovered())ImGui::SetTooltip(kind==1?"Insert %s's dedicated %s trap. Starts empty for capture.":"Place %s on the portal.",name.c_str(),detail);
+            ImGui::PopStyleVar();ImGui::PopStyleColor(2);
+            ImGui::TextWrapped("%s",name.c_str());
+            ImGui::TextColored(accent,"%s",state&2?"INSERTED":kind==1?(state&1?"Saved trap":detail):"Skylander");
+            ImGui::Dummy({0,8*base_scale});ImGui::PopID();
+        }
+        ImGui::EndTable();
+    }
+    if(!shown)ImGui::TextWrapped(kind==0?"Import a Skylander dump to add it to your collection.":"No villains match this filter.");
+    ImGui::EndChild();
+    if(ImGui::Button(kind==1?"Eject trap":"Remove Skylander",{-1,30*base_scale})&&sky_portal_action)sky_portal_action(kind==1?4:3,0);
+    ImGui::TextDisabled("%d in collection",count);
+}
